# Clerk authentication
# Get these from https://dashboard.clerk.com → your app → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Optional: where Clerk sends users for sign-in / sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Database (Prisma ORM). Requires PostgreSQL >= 15.
# Local dev: `docker run -d --name cms-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=cms -p 5432:5432 postgres:16`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cms"
